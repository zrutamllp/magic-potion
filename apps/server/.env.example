# Neon branches: "dev" for this file, "tests" for TEST_DATABASE_URL below, and "production" only
# in Render (never here). Neon shows sslmode=require; the app always uses sslmode=verify-full.
# Neon pooled connection string (host contains "-pooler"). Used by the app at runtime.
DATABASE_URL=
# Neon direct connection string (same host without "-pooler"). Used by Prisma migrations.
DIRECT_URL=
# Long random string (at least 32 characters) for signing login tokens. Required with DATABASE_URL.
JWT_SECRET=
# Frontend URL(s) allowed by CORS, comma-separated. Local default: http://localhost:5173
CLIENT_ORIGIN=http://localhost:5173
# Port to listen on. Render sets this automatically.
PORT=4000
# Creates the first main admin when you run `npm run db:seed`.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
# Optional. The Neon "tests" branch (pooled string), for the database tests; npm test skips them
# when empty. They create and delete games, so they refuse the branch in DATABASE_URL and any
# database marked as production.
TEST_DATABASE_URL=
# Vercel Blob read-write token (public store) for uploaded pictures: client logo and task images.
# Uploads are switched off when empty. Keep it secret: never paste it in logs or screenshots.
BLOB_READ_WRITE_TOKEN=
# Optional. Failed logins of any kind from one address in 10 minutes before that address waits.
# Default 200: high on purpose, because a whole room can share one Wi-Fi or VPN address.
LOGIN_FAILURES_PER_ADDRESS=
# Team photos (they show real employees) go to a PRIVATE Vercel Blob store: create a second
# store with private access and paste its read-write token here. Photo upload is off when empty.
BLOB_PRIVATE_READ_WRITE_TOKEN=
# Signs the short-lived staff-only links to team photos (5 minutes). Its own long random string,
# at least 32 characters, separate from JWT_SECRET so rotating one never breaks the other.
PHOTO_LINK_SECRET=
# The public picture store's host, the start of any logo address, for example
# abc123.public.blob.vercel-storage.com (not a secret). Intro video files must come from it;
# without it only YouTube and Vimeo links are allowed. Required in production. It must match
# media-src in apps/web/vercel.json. The connection check page (/check) loads its test picture
# from it: connection-check/pixel.png (upload docs/connection-check/pixel.png there once).
PUBLIC_BLOB_HOST=
# Local testing only. "true" turns on helpers such as the staff page's "Finish all 5 tasks" button.
# Always off when NODE_ENV=production. Never set this for a live event.
ENABLE_DEV_TOOLS=
