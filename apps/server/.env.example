# Neon connection strings: use sslmode=verify-full (Neon shows sslmode=require; the app changes it).
# Neon pooled connection string (host contains "-pooler"). Used by the app at runtime.
DATABASE_URL=
# Neon direct connection string (same host without "-pooler"). Used by Prisma migrations.
DIRECT_URL=
# Long random string (at least 32 characters) for signing login tokens. Required with DATABASE_URL.
JWT_SECRET=
# Frontend URL(s) allowed by CORS, comma-separated. Local default: http://localhost:5173
CLIENT_ORIGIN=http://localhost:5173
# Port to listen on. Render sets this automatically.
PORT=4000
# Creates the first main admin when you run `npm run db:seed`.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
# Optional. A Neon branch for the database integration test (npm test skips it when empty).
# Never point this at the database used for live events: the test creates and deletes a game.
TEST_DATABASE_URL=
# Vercel Blob read-write token (public store) for uploaded pictures: client logo and task images.
# Uploads are switched off when empty. Keep it secret: never paste it in logs or screenshots.
BLOB_READ_WRITE_TOKEN=
# Team photos (they show real employees) go to a PRIVATE Vercel Blob store: create a second
# store with private access and paste its read-write token here. Photo upload is off when empty.
BLOB_PRIVATE_READ_WRITE_TOKEN=
# Signs the short-lived staff-only links to team photos (5 minutes). Its own long random string,
# at least 32 characters, separate from JWT_SECRET so rotating one never breaks the other.
PHOTO_LINK_SECRET=
# Local testing only. "true" turns on helpers such as the staff page's "Finish all 5 tasks" button.
# Always off when NODE_ENV=production. Never set this for a live event.
ENABLE_DEV_TOOLS=
